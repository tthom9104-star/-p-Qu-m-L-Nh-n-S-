# MySQL trên máy:  mysql://root:MAT_KHAU@127.0.0.1:3306/coral_hr
# Aiven (Service URI): mysql://avnadmin:MAT_KHAU@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=mysql://root:MAT_KHAU@127.0.0.1:3306/coral_hr

# BẮT BUỘC đặt giá trị riêng của bạn (không dùng chuỗi mẫu).
# Khi chạy trên Render (NODE_ENV=production) hoặc nối DB từ xa, server sẽ từ chối chạy nếu:
#   JWT_SECRET < 32 ký tự, hoặc ADMIN_PASS < 8 ký tự / là mật khẩu quen thuộc.
# Tạo JWT_SECRET:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_USER=admin
ADMIN_PASS=

# URL frontend trên Vercel (không có dấu / ở cuối). Nhiều URL cách nhau bằng dấu phẩy.
# Khi NODE_ENV=production, localhost KHÔNG còn được cho phép.
FRONTEND_URL=http://localhost:5173

# Đặt "production" trên Render.
NODE_ENV=development

# Nút "Đặt lại dữ liệu" trong Cài đặt (xóa sạch rồi nạp dữ liệu mẫu). Mặc định TẮT.
ALLOW_RESET=false

# (Khuyến nghị với Aiven) Dán nội dung CA certificate, thay xuống dòng bằng \n, để kiểm tra chứng chỉ SSL.
# Aiven Console > service > Overview > CA certificate.
DB_CA=
